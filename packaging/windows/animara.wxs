<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX Toolset v4+ installer for Animara.
  Build:  wix build packaging/windows/animara.wxs -arch x64 -d Version=0.1.0 -d BinDir=target\release -o dist\Animara-0.1.0-windows-x64.msi
  Features: per-machine install, Start-menu shortcut, optional desktop shortcut, .anim file association,
  uninstall via Apps & Features, major upgrades of older versions.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Animara" Manufacturer="Animara contributors" Version="$(var.Version)"
           UpgradeCode="7D4C9B1E-3A55-4E2B-9C1D-6A2F0B8E4C11" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Animara is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AnimaraIcon" SourceFile="$(var.BinDir)\animara.exe" />
    <Property Id="ARPPRODUCTICON" Value="AnimaraIcon" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Animara">
        <Component Id="MainExe" Guid="*">
          <File Id="AnimaraExe" Source="$(var.BinDir)\animara.exe" KeyPath="yes" />
          <ProgId Id="Animara.Document" Description="Animara animation document" Icon="AnimaraExe">
            <Extension Id="anim" ContentType="application/x-animara">
              <Verb Id="open" Command="Open" TargetFile="AnimaraExe" Argument="&quot;%1&quot;" />
            </Extension>
          </ProgId>
        </Component>
        <Component Id="CliExe" Guid="*">
          <File Id="AnimaraCliExe" Source="$(var.BinDir)\animara-cli.exe" KeyPath="yes" />
          <Environment Id="PathEnv" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="AnimaraStartMenu" Name="Animara" Target="[INSTALLFOLDER]animara.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Animara" Name="startmenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*" Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="AnimaraDesktop" Name="Animara" Target="[INSTALLFOLDER]animara.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Animara" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Animara" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="CliExe" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>
</Wix>
